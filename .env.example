# ==============================================================================
# COMPLETE SINHALA VOCABULARY ENCYCLOPEDIA - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Configuration (UTF-8 required for Sinhala & Tamil Unicode)
DATABASE_URL=postgresql://postgres@localhost:5432/learn_sinhala

# Optional Redis Configuration for BullMQ Distributed Job Queue
# When REDIS_URL is omitted or unreachable, the system automatically uses its
# durable PostgreSQL-backed transactional research queue.
REDIS_URL=

# Authentication & Role-Based Access Control (Admin / Linguist Reviewer)
JWT_SECRET=sinhala-encyclopedia-super-secret-jwt-key-change-in-prod
ADMIN_ACCESS_CODE=SINHALA-ADMIN-2026

# Provider-Independent AI / LLM Configuration (Kept exclusively on Backend)
# Supported values: "auto" | "gemini" | "openai" | "anthropic" | "corpus_verified"
LLM_PROVIDER=auto

# Optional API Keys for External LLM Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Autonomous Vocabulary Research Agent Settings
AGENT_BATCH_SIZE=8
AGENT_RATE_LIMIT_MS=400
AGENT_AUTO_SCHEDULE_MINUTES=60
AGENT_MIN_AUTO_VERIFY_CONFIDENCE=0.88
